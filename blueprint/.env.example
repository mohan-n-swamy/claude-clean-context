# Example retrieval-layer environment.
# Never commit real values. Copy to a private .env file and fill in your own
# database, embedding, and auth settings.

DB_URL=postgres://USER:PASSWORD@HOST:PORT/DB
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<database-password>
POSTGRES_DB=<database-name>
DB_IMAGE=<postgres-with-vector-extension-image>

EMBEDDINGS_API=http://localhost:PORT/v1
EMBEDDING_MODEL=<your-embedding-model>
EMBEDDINGS_IMAGE=<standard-embeddings-api-image>
EMBEDDINGS_API_KEY=<optional-embedding-api-key>

MCP_IMAGE=<your-retrieval-mcp-server-image>
MCP_AUTH_TOKEN=<generate-one>
